{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Explicit subject lineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "mappings"
  ],
  "properties": {
    "schema": {
      "const": "subject-mappings/v1"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "minLength": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "from",
          "to",
          "reason"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "rename",
              "move",
              "split",
              "modify"
            ]
          },
          "from": {
            "type": "string",
            "pattern": "^subject-identity/v1:[0-9a-f]{64}$"
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^subject-identity/v1:[0-9a-f]{64}$"
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    }
  }
}
