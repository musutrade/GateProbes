{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harness normalized evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "project",
    "component",
    "collector",
    "series",
    "subject",
    "context",
    "source",
    "metrics",
    "capabilities",
    "artifacts",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "harness-evidence/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "collector": {
      "$ref": "#/definitions/Versioned"
    },
    "series": {
      "$ref": "#/definitions/Series"
    },
    "subject": {
      "$ref": "#/definitions/Subject"
    },
    "context": {
      "$ref": "#/definitions/Context"
    },
    "source": {
      "$ref": "#/definitions/Source"
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Metric"
      },
      "minItems": 0
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Capability"
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Artifact"
      },
      "minItems": 1
    },
    "status": {
      "enum": [
        "measured",
        "unavailable",
        "measurement_error"
      ]
    },
    "contract": {
      "$ref": "#/definitions/Contract"
    }
  },
  "definitions": {
    "Versioned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$"
        }
      }
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "base_commit",
        "target",
        "run"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "run": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$"
        }
      }
    },
    "MetricContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "type": {
          "enum": [
            "ratio",
            "count",
            "boolean",
            "duration",
            "size",
            "decimal",
            "rational"
          ]
        }
      }
    },
    "Series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "collector",
        "tool",
        "rule",
        "runtime",
        "target",
        "source_identity",
        "normalization",
        "metrics"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^measurement-series/v1:[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "collector": {
          "$ref": "#/definitions/Versioned"
        },
        "tool": {
          "$ref": "#/definitions/Versioned"
        },
        "rule": {
          "$ref": "#/definitions/Versioned"
        },
        "runtime": {
          "$ref": "#/definitions/Versioned"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "source_identity": {
          "$ref": "#/definitions/Versioned"
        },
        "normalization": {
          "$ref": "#/definitions/Versioned"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MetricContract"
          },
          "minItems": 1
        }
      }
    },
    "Ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "covered",
        "total"
      ],
      "properties": {
        "type": {
          "const": "ratio"
        },
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "count"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Boolean": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "boolean"
        },
        "value": {
          "type": "boolean"
        }
      }
    },
    "Duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value",
        "unit"
      ],
      "properties": {
        "type": {
          "const": "duration"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "const": "nanoseconds"
        }
      }
    },
    "Size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value",
        "unit"
      ],
      "properties": {
        "type": {
          "const": "size"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "const": "bytes"
        }
      }
    },
    "Decimal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "decimal"
        },
        "value": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
        }
      }
    },
    "Value": {
      "oneOf": [
        {
          "$ref": "#/definitions/Ratio"
        },
        {
          "$ref": "#/definitions/Count"
        },
        {
          "$ref": "#/definitions/Boolean"
        },
        {
          "$ref": "#/definitions/Duration"
        },
        {
          "$ref": "#/definitions/Size"
        },
        {
          "$ref": "#/definitions/Decimal"
        },
        {
          "$ref": "#/definitions/Rational"
        }
      ],
      "description": "Explicitly discriminated values. Ratios preserve covered/total; no floating JSON numbers. Semantic validation enforces covered <= total and the named metric contract."
    },
    "Metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "artifacts"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "value": {
          "$ref": "#/definitions/Value"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          }
        }
      }
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "state",
        "reason",
        "artifacts"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "state": {
          "enum": [
            "supported",
            "unsupported",
            "not_configured",
            "not_collected",
            "measurement_error",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          }
        }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "media_type",
        "path",
        "sha256",
        "bytes",
        "context",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "kind": {
          "const": "raw"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "context": {
          "$ref": "#/definitions/Context"
        },
        "source": {
          "$ref": "#/definitions/Source"
        }
      }
    },
    "Subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "identity_version",
        "component",
        "target",
        "boundary",
        "kind",
        "path",
        "discriminator",
        "source_sha256",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^subject-identity/v1:[0-9a-f]{64}$"
        },
        "identity_version": {
          "const": "subject-identity/v1"
        },
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "project/v1",
            "component/v1",
            "boundary/v1",
            "file/v1",
            "function/v1",
            "method/v1",
            "class/v1",
            "route/v1",
            "endpoint/v1",
            "contract/v1",
            "dependency/v1",
            "critical_path/v1"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "discriminator": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "$ref": "#/definitions/Span"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "properties": {
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_column": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "numerator",
        "denominator"
      ],
      "properties": {
        "type": {
          "const": "rational"
        },
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship",
        "producer",
        "consumer",
        "contract_artifact"
      ],
      "properties": {
        "relationship": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "producer": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "consumer": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "contract_artifact": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact",
            "commit",
            "series_id"
          ],
          "properties": {
            "artifact": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]*$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "series_id": {
              "type": "string",
              "pattern": "^measurement-series/v1:[0-9a-f]{64}$"
            }
          }
        },
        "consumer_artifact": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "generated_client": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact",
            "contract_sha256"
          ],
          "properties": {
            "artifact": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]*$"
            },
            "contract_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  },
  "description": "Structural schema plus harness_evidence.py semantic and filesystem validation. A valid envelope is not a release pass."
}
