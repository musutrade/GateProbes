{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/musutrade/Harness-Gate/schema/adapter-request.schema.json",
  "title": "Harness-Gate Adapter Request v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "result_schema_version",
    "adapter",
    "invocation_id",
    "step_id",
    "timeout_ms",
    "config_digest",
    "artifact_root",
    "nonce",
    "issued_at_ms",
    "expires_at_ms",
    "args",
    "environment",
    "capabilities",
    "input"
  ],
  "properties": {
    "protocol_version": { "const": 2 },
    "result_schema_version": { "const": "1" },
    "adapter": { "$ref": "#/$defs/adapter" },
    "invocation_id": { "type": "string", "minLength": 1 },
    "step_id": { "type": "string", "minLength": 1 },
    "timeout_ms": { "type": "integer", "minimum": 1 },
    "config_digest": { "type": "string", "minLength": 1 },
    "artifact_root": { "type": "string", "minLength": 1 },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "issued_at_ms": { "type": "integer", "minimum": 0 },
    "expires_at_ms": { "type": "integer", "minimum": 1 },
    "args": { "type": "array", "items": { "type": "string" } },
    "environment": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "input": {}
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executable", "source_digest", "signature"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "minLength": 1 },
        "source_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "resources", "environment"],
      "properties": {
        "network": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "resources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "environment": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
