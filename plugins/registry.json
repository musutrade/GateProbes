{
  "schema": "gateprobes-plugin-registry/v1",
  "languages": [
    "rust",
    "python",
    "typescript"
  ],
  "plugins": {
    "typescript-risk": {
      "path": "plugins/typescript-risk",
      "language": "typescript",
      "platforms": [
        "linux"
      ],
      "toolchain": "node 24",
      "entries": {
        "install": "npm ci --ignore-scripts",
        "test": "npm test",
        "contract": "npm run test:core",
        "package": "npm pack --ignore-scripts"
      },
      "protocols": [
        "protocol/collector-protocol.schema.json"
      ],
      "toolchains": [
        "typescript"
      ]
    },
    "rust-measure": {
      "path": "plugins/rust-measure",
      "language": "rust",
      "platforms": [
        "linux"
      ],
      "toolchain": "rust stable",
      "entries": {
        "install": "cargo build --locked --release",
        "test": "cargo test --locked",
        "contract": "python3 contract.py --binary target/release/harness-gate-rust-measure --core-root \"$RUNNER_TEMP/core/tools/quality\"",
        "package": "cargo build --locked --release"
      },
      "protocols": [],
      "toolchains": [
        "rust"
      ],
      "rust_toolchain": "stable",
      "rust_components": "rustfmt, clippy, llvm-tools-preview",
      "cargo_checks": true
    },
    "http-json-contract": {
      "path": "plugins/http-json-contract",
      "language": "typescript",
      "platforms": [
        "linux"
      ],
      "toolchain": "node 24",
      "entries": {
        "install": "npm ci --ignore-scripts",
        "test": "npm test",
        "contract": "python3 contract.py --cli cli.cjs --core-root \"$RUNNER_TEMP/core/tools/quality\"",
        "package": "npm pack --ignore-scripts"
      },
      "protocols": [],
      "toolchains": [
        "typescript"
      ]
    },
    "rust-source-risk": {
      "path": "plugins/rust-source-risk",
      "language": "python",
      "toolchains": [
        "python",
        "rust"
      ],
      "platforms": [
        "linux"
      ],
      "toolchain": "python 3.14 + rust stable",
      "entries": {
        "install": "cargo build --locked --release --manifest-path ast/Cargo.toml && cp ast/target/release/harness-gate-rust-source-inventory inventory",
        "test": "cargo test --locked --manifest-path ast/Cargo.toml && RUST_SOURCE_INVENTORY=\"$PWD/inventory\" python3 -m unittest discover -s . -p \"test_*.py\" -v",
        "contract": "RUST_SOURCE_INVENTORY=\"$PWD/inventory\" python3 -m unittest test_protocol -v && python3 contract.py --core-root \"$RUNNER_TEMP/core/tools/quality\"",
        "package": "tar -czf \"harness-gate-rust-source-risk-$(python3 -c \"import json;print(json.load(open('plugin.json'))['version'])\")-linux-amd64.tar.gz\" plugin.py measure.py capture.py plugin.json LICENSE README.md inventory ast/Cargo.lock"
      },
      "protocols": [],
      "rust_toolchain": "stable",
      "rust_components": "rustfmt, clippy, llvm-tools-preview"
    },
    "rust-native-plugin": {
      "path": "plugins/rust-native-plugin",
      "language": "rust",
      "toolchains": [
        "python",
        "rust"
      ],
      "rust_toolchain": "1.97.1",
      "rust_components": "rustc-dev, llvm-tools-preview, rust-docs, rustfmt, clippy",
      "cargo_checks": false,
      "merges_schemas": true,
      "platforms": [
        "linux",
        "macos-amd64",
        "macos-arm64",
        "windows-amd64"
      ],
      "toolchain": "rust 1.97.1 + python 3.14 + openssl + rustc-dev/llvm-tools/rust-docs + linker + strip",
      "entries": {
        "install": "RUSTC_BOOTSTRAP=1 CARGO_TARGET_DIR=\"$GITHUB_WORKSPACE/plugins/target/native-driver\" cargo build --locked --manifest-path \"$GITHUB_WORKSPACE/plugins/rust-native-driver/Cargo.toml\" && HARNESS_GATE_SBOM_TOOL=\"$RUNNER_TEMP/core/generate-sbom.py\" HARNESS_GATE_FROZEN_MODULES_DIR=\"$RUNNER_TEMP/core/tools/quality\" HARNESS_GATE_NATIVE_DRIVER_MANIFEST=\"$GITHUB_WORKSPACE/plugins/rust-native-driver/Cargo.toml\" python3 build.py --driver \"$GITHUB_WORKSPACE/plugins/target/native-driver/debug/harness-gate-rust-native-driver$NATIVE_SUFFIX\" --output \"$GITHUB_WORKSPACE/plugins/rust-native-output\" --rustc \"$(rustc --print sysroot)/bin/rustc$NATIVE_SUFFIX\"",
        "test": "PYTHONPATH=\"$GITHUB_WORKSPACE/plugins/rust-native-plugin$(python3 -c 'import os;print(os.pathsep,end=\"\")')$GITHUB_WORKSPACE/plugins/rust-native-plugin/tests$(python3 -c 'import os;print(os.pathsep,end=\"\")')$RUNNER_TEMP/core/tools/quality\" python3 tests/zero_skip.py test_rust_collector_project",
        "contract": "HARNESS_GATE_NATIVE_ACCEPTANCE_ROOT=\"$RUNNER_TEMP/native-acceptance\" NATIVE_PLUGIN_BINARY=\"$GITHUB_WORKSPACE/plugins/rust-native-output/$NATIVE_ASSET\" NATIVE_DRIVER=\"$GITHUB_WORKSPACE/plugins/target/native-driver/debug/harness-gate-rust-native-driver$NATIVE_SUFFIX\" NATIVE_DRIVER_SYSROOT=\"$(rustc --print sysroot)\" HARNESS_GATE_NATIVE_POLICY_BINARY=\"$RUNNER_TEMP/core/bin/$CORE_ASSET\" HARNESS_GATE_PRESETS_DIR=\"$RUNNER_TEMP/core/presets\" PYTHONPATH=\"$GITHUB_WORKSPACE/plugins/rust-native-plugin$(python3 -c 'import os;print(os.pathsep,end=\"\")')$GITHUB_WORKSPACE/plugins/rust-native-plugin/tests$(python3 -c 'import os;print(os.pathsep,end=\"\")')$RUNNER_TEMP/core/tools/quality\" python3 accept.py",
        "package": "asset=\"$GITHUB_WORKSPACE/plugins/rust-native-output/$NATIVE_ASSET\"; test -s \"$asset\" && test -s \"${asset%.exe}.sbom.cdx.json\" && python3 -c \"import hashlib,sys;print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest(), sys.argv[1])\" \"$asset\""
      },
      "protocols": [],
      "companions": [
        "plugins/rust-native-driver"
      ]
    },
    "postgres-service": {
      "path": "plugins/postgres-service",
      "language": "rust",
      "platforms": [
        "linux"
      ],
      "toolchain": "rust stable + Python test harness + external pg_isready",
      "toolchains": [
        "rust",
        "python"
      ],
      "rust_toolchain": "stable",
      "rust_components": "rustfmt, clippy",
      "cargo_checks": true,
      "entries": {
        "install": "cargo build --locked --release",
        "test": "cargo test --locked",
        "contract": "python3 contract.py --binary target/release/gateprobes-postgres --core-binary \"$RUNNER_TEMP/core/bin/$CORE_ASSET\"",
        "package": "HARNESS_GATE_POSTGRES_ACCEPTANCE=\"$RUNNER_TEMP/postgres-acceptance\" python3 ../../tools/release/package_plugin.py --plugin postgres-service --core-root \"$RUNNER_TEMP/core\" --output \"$RUNNER_TEMP/postgres-package\""
      },
      "protocols": [
        "protocol/service-check.schema.json"
      ]
    },
    "github-check": {
      "path": "plugins/github-check",
      "language": "python",
      "platforms": [
        "linux"
      ],
      "toolchain": "Python 3.11+ and OpenSSL (acceptance only)",
      "toolchains": [
        "python"
      ],
      "entries": {
        "install": "python3 github_check.py --help",
        "test": "GATEHOUSE_CORE=\"$RUNNER_TEMP/core/bin/harness-gate-linux-amd64\" python3 accept.py",
        "contract": "GATEHOUSE_CORE=\"$RUNNER_TEMP/core/bin/harness-gate-linux-amd64\" python3 accept.py",
        "package": "python3 ../../tools/release/package_plugin.py --plugin github-check --core-root \"$RUNNER_TEMP/core\" --output \"$RUNNER_TEMP/github-check-package\""
      },
      "protocols": []
    },
    "onboarding-presets": {
      "path": "plugins/onboarding-presets",
      "language": "python",
      "platforms": [
        "linux"
      ],
      "toolchain": "Python 3.11+, OpenSSL, Git, Rust stable",
      "toolchains": [
        "python",
        "rust"
      ],
      "rust_toolchain": "stable",
      "rust_components": "rustfmt, clippy",
      "entries": {
        "install": "python3 ../../tools/onboarding/plugin_manager.py --help",
        "test": "python3 -m unittest discover -s ../../tools/onboarding -p \"test_*.py\" -v && GATEHOUSE_CORE=\"$RUNNER_TEMP/core/bin/harness-gate-linux-amd64\" python3 -m unittest discover -s tests_package -p \"test_*.py\" -v",
        "contract": "python3 ../../tools/onboarding/acceptance.py --core \"$RUNNER_TEMP/core/bin/harness-gate-linux-amd64\" --work-dir \"$RUNNER_TEMP/onboarding-contract\"",
        "package": "python3 ../../tools/release/package_plugin.py --plugin onboarding-presets --core-root \"$RUNNER_TEMP/core\" --output \"$RUNNER_TEMP/onboarding-package\""
      },
      "protocols": []
    },
    "github-actions": {
      "path": "plugins/github-actions",
      "language": "python",
      "platforms": [
        "linux"
      ],
      "toolchain": "Node24 + Python3.11 packaging",
      "toolchains": [
        "python",
        "typescript"
      ],
      "entries": {
        "install": "node --version",
        "test": "node --test actions/findings-feedback/feedback.test.cjs actions/report-artifact/prepare.test.cjs && python3 -m unittest discover -s tests_package -p \"test_*.py\" -v",
        "contract": "node --test actions/findings-feedback/feedback.test.cjs actions/report-artifact/prepare.test.cjs",
        "package": "python3 ../../tools/release/package_plugin.py --plugin github-actions --core-root \"$RUNNER_TEMP/core\" --output \"$RUNNER_TEMP/github-actions-package\""
      },
      "protocols": []
    },
    "operator-lifecycle": {
      "path": "plugins/operator-lifecycle",
      "language": "rust",
      "platforms": [
        "linux"
      ],
      "toolchain": "Rust stable + Python3 + Git",
      "toolchains": [
        "rust",
        "python"
      ],
      "rust_toolchain": "stable",
      "rust_components": "rustfmt, clippy",
      "cargo_checks": true,
      "entries": {
        "install": "cargo build --locked --release",
        "test": "cargo test --locked",
        "contract": "python3 accept.py --binary target/release/gateprobes-operator --core \"$RUNNER_TEMP/core/bin/harness-gate-linux-amd64\"",
        "package": "python3 ../../tools/release/package_plugin.py --plugin operator-lifecycle --core-root \"$RUNNER_TEMP/core\" --output \"$RUNNER_TEMP/operator-package\""
      },
      "protocols": []
    },
    "docker-runtime": {
      "path": "plugins/docker-runtime/native",
      "language": "rust",
      "platforms": [
        "linux"
      ],
      "toolchain": "Rust 1.99.1 + Python3",
      "toolchains": [
        "rust",
        "python"
      ],
      "rust_toolchain": "1.99.1",
      "rust_components": "rustfmt, clippy, rust-docs",
      "cargo_checks": true,
      "entries": {
        "install": "CARGO_TARGET_DIR=\"$RUNNER_TEMP/docker-runtime-build\" cargo build --locked --release --target x86_64-unknown-linux-musl",
        "test": "cargo test --locked --target x86_64-unknown-linux-musl",
        "contract": "python3 ../accept.py --binary \"$RUNNER_TEMP/docker-runtime-build/x86_64-unknown-linux-musl/release/gateprobes-docker-runtime\" --core \"$RUNNER_TEMP/core/bin/harness-gate-linux-amd64\" --version 0.1.1 --report \"$RUNNER_TEMP/docker-runtime-contract.json\"",
        "package": "python3 -c 'raise SystemExit(\"docker-runtime 0.1.1 is immutable; current-source packaging is retired\")'"
      },
      "protocols": [],
      "dedicated_ci": "runtime-wire"
    },
    "runtime-importer": {
      "path": "plugins/runtime-importer",
      "language": "python",
      "platforms": [
        "linux"
      ],
      "toolchain": "Python 3.11+; package-local released Core0.8.0",
      "toolchains": [
        "python"
      ],
      "dedicated_ci": "runtime-importer",
      "entries": {
        "install": "python3 -I -B ../../tools/runtime_import/install.py --help",
        "test": "python3 -m unittest discover -s tests_package -v",
        "contract": "python3 ../../tools/release/accept_importer.py --help",
        "package": "python3 ../../tools/release/package_plugin.py --plugin runtime-importer --core-root \"$RUNNER_TEMP/importer-core\" --output \"$RUNNER_TEMP/importer-dist\""
      },
      "protocols": []
    },
    "docker-readiness": {
      "path": "plugins/docker-readiness",
      "language": "rust",
      "platforms": [
        "linux"
      ],
      "toolchain": "Rust 1.99.1 + Python3; pinned released Core0.9",
      "toolchains": [
        "rust",
        "python"
      ],
      "rust_toolchain": "1.99.1",
      "cargo_checks": false,
      "dedicated_ci": "runtime-wire",
      "entries": {
        "install": "CARGO_TARGET_DIR=\"$RUNNER_TEMP/readiness-build\" cargo build --locked --manifest-path ../docker-runtime/native/Cargo.toml --bin gateprobes-docker-readiness",
        "test": "python3 -m unittest discover -s ../docker-runtime/tests_package -v",
        "contract": "python3 accept.py --core \"$RUNNER_TEMP/core/bin/harness-gate-linux-amd64\" --binary \"$RUNNER_TEMP/readiness-build/debug/gateprobes-docker-readiness\" --version 0.2.0 --report \"$RUNNER_TEMP/readiness-contract.json\"",
        "package": "python3 ../../tools/release/package_plugin.py --plugin docker-readiness --core-root \"$RUNNER_TEMP/core\" --output \"$RUNNER_TEMP/readiness-dist\""
      },
      "protocols": [],
      "rust_components": "rustfmt, clippy, rust-docs"
    }
  },
  "runners": {
    "linux": {
      "runner": "ubuntu-24.04",
      "suffix": "",
      "asset": "harness-gate-rust-collector-linux-amd64",
      "target": "x86_64-unknown-linux-gnu"
    },
    "macos-amd64": {
      "runner": "macos-15-intel",
      "suffix": "",
      "asset": "harness-gate-rust-collector-macos-amd64",
      "target": "x86_64-apple-darwin"
    },
    "macos-arm64": {
      "runner": "macos-15",
      "suffix": "",
      "asset": "harness-gate-rust-collector-macos-arm64",
      "target": "aarch64-apple-darwin"
    },
    "windows-amd64": {
      "runner": "windows-2025",
      "suffix": ".exe",
      "asset": "harness-gate-rust-collector-windows-amd64.exe",
      "target": "x86_64-pc-windows-msvc"
    }
  }
}
