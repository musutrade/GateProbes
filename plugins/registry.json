{
  "schema": "gateprobes-plugin-registry/v1",
  "languages": [
    "rust",
    "python",
    "typescript"
  ],
  "plugins": {
    "typescript-risk": {
      "path": "plugins/typescript-risk",
      "language": "typescript",
      "platforms": [
        "linux"
      ],
      "toolchain": "node 24",
      "entries": {
        "install": "npm ci --ignore-scripts",
        "test": "npm test",
        "contract": "npm run test:core",
        "package": "npm pack --ignore-scripts"
      },
      "protocols": [
        "protocol/collector-protocol.schema.json"
      ],
      "toolchains": [
        "typescript"
      ]
    },
    "rust-measure": {
      "path": "plugins/rust-measure",
      "language": "rust",
      "platforms": [
        "linux"
      ],
      "toolchain": "rust stable",
      "entries": {
        "install": "cargo build --locked --release",
        "test": "cargo test --locked",
        "contract": "python3 contract.py --binary target/release/harness-gate-rust-measure --core-root \"$RUNNER_TEMP/core/tools/quality\"",
        "package": "cargo build --locked --release"
      },
      "protocols": [],
      "toolchains": [
        "rust"
      ],
      "rust_toolchain": "stable",
      "rust_components": "rustfmt, clippy, llvm-tools-preview",
      "cargo_checks": true
    },
    "http-json-contract": {
      "path": "plugins/http-json-contract",
      "language": "typescript",
      "platforms": [
        "linux"
      ],
      "toolchain": "node 24",
      "entries": {
        "install": "npm ci --ignore-scripts",
        "test": "npm test",
        "contract": "python3 contract.py --cli cli.cjs --core-root \"$RUNNER_TEMP/core/tools/quality\"",
        "package": "npm pack --ignore-scripts"
      },
      "protocols": [],
      "toolchains": [
        "typescript"
      ]
    },
    "rust-source-risk": {
      "path": "plugins/rust-source-risk",
      "language": "python",
      "toolchains": [
        "python",
        "rust"
      ],
      "platforms": [
        "linux"
      ],
      "toolchain": "python 3.14 + rust stable",
      "entries": {
        "install": "cargo build --locked --release --manifest-path ast/Cargo.toml && cp ast/target/release/harness-gate-rust-source-inventory inventory",
        "test": "cargo test --locked --manifest-path ast/Cargo.toml && RUST_SOURCE_INVENTORY=\"$PWD/inventory\" python3 -m unittest discover -s . -p \"test_*.py\" -v",
        "contract": "RUST_SOURCE_INVENTORY=\"$PWD/inventory\" python3 -m unittest test_protocol -v && python3 contract.py --core-root \"$RUNNER_TEMP/core/tools/quality\"",
        "package": "tar -czf \"harness-gate-rust-source-risk-$(python3 -c \"import json;print(json.load(open('plugin.json'))['version'])\")-linux-amd64.tar.gz\" plugin.py measure.py capture.py plugin.json LICENSE README.md inventory ast/Cargo.lock"
      },
      "protocols": [],
      "rust_toolchain": "stable",
      "rust_components": "rustfmt, clippy, llvm-tools-preview"
    },
    "rust-native-plugin": {
      "path": "plugins/rust-native-plugin",
      "language": "rust",
      "toolchains": [
        "python",
        "rust"
      ],
      "rust_toolchain": "1.97.1",
      "rust_components": "rustc-dev, llvm-tools-preview, rust-docs, rustfmt, clippy",
      "cargo_checks": false,
      "merges_schemas": true,
      "platforms": [
        "linux",
        "macos-amd64",
        "macos-arm64",
        "windows-amd64"
      ],
      "toolchain": "rust 1.97.1 + python 3.14 + openssl + rustc-dev/llvm-tools/rust-docs + linker + strip",
      "entries": {
        "install": "RUSTC_BOOTSTRAP=1 CARGO_TARGET_DIR=\"$GITHUB_WORKSPACE/plugins/target/native-driver\" cargo build --locked --manifest-path \"$GITHUB_WORKSPACE/plugins/rust-native-driver/Cargo.toml\" && HARNESS_GATE_SBOM_TOOL=\"$RUNNER_TEMP/core/generate-sbom.py\" HARNESS_GATE_FROZEN_MODULES_DIR=\"$RUNNER_TEMP/core/tools/quality\" HARNESS_GATE_NATIVE_DRIVER_MANIFEST=\"$GITHUB_WORKSPACE/plugins/rust-native-driver/Cargo.toml\" python3 build.py --driver \"$GITHUB_WORKSPACE/plugins/target/native-driver/debug/harness-gate-rust-native-driver$NATIVE_SUFFIX\" --output \"$GITHUB_WORKSPACE/plugins/rust-native-output\" --rustc \"$(rustc --print sysroot)/bin/rustc$NATIVE_SUFFIX\"",
        "test": "PYTHONPATH=\"$GITHUB_WORKSPACE/plugins/rust-native-plugin:$GITHUB_WORKSPACE/plugins/rust-native-plugin/tests:$RUNNER_TEMP/core/tools/quality\" python3 tests/zero_skip.py test_rust_collector_project",
        "contract": "HARNESS_GATE_NATIVE_ACCEPTANCE_ROOT=\"$RUNNER_TEMP/native-acceptance\" NATIVE_PLUGIN_BINARY=\"$GITHUB_WORKSPACE/plugins/rust-native-output/$NATIVE_ASSET\" NATIVE_DRIVER=\"$GITHUB_WORKSPACE/plugins/target/native-driver/debug/harness-gate-rust-native-driver$NATIVE_SUFFIX\" NATIVE_DRIVER_SYSROOT=\"$(rustc --print sysroot)\" HARNESS_GATE_NATIVE_POLICY_BINARY=\"$RUNNER_TEMP/core/bin/$CORE_ASSET\" HARNESS_GATE_PRESETS_DIR=\"$RUNNER_TEMP/core/presets\" PYTHONPATH=\"$GITHUB_WORKSPACE/plugins/rust-native-plugin:$GITHUB_WORKSPACE/plugins/rust-native-plugin/tests:$RUNNER_TEMP/core/tools/quality\" python3 accept.py",
        "package": "asset=\"$GITHUB_WORKSPACE/plugins/rust-native-output/$NATIVE_ASSET\"; test -s \"$asset\" && test -s \"${asset%.exe}.sbom.cdx.json\" && sha256sum \"$asset\""
      },
      "protocols": [],
      "companions": [
        "plugins/rust-native-driver"
      ]
    }
  },
  "runners": {
    "linux": {
      "runner": "ubuntu-24.04",
      "suffix": "",
      "asset": "harness-gate-rust-collector-linux-amd64"
    },
    "macos-amd64": {
      "runner": "macos-15-intel",
      "suffix": "",
      "asset": "harness-gate-rust-collector-macos-amd64"
    },
    "macos-arm64": {
      "runner": "macos-15",
      "suffix": "",
      "asset": "harness-gate-rust-collector-macos-arm64"
    },
    "windows-amd64": {
      "runner": "windows-2025",
      "suffix": ".exe",
      "asset": "harness-gate-rust-collector-windows-amd64.exe"
    }
  }
}
