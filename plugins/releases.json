      "manifests": [
        "plugin.json"
      ]
    },
    "github-actions": {
      "tag_prefix": "github-actions-v",
      "archive": "gateprobes-github-actions-{version}.tar.gz",
      "manifests": [
        "plugin.json"
      ]
    },
    "operator-lifecycle": {
      "tag_prefix": "operator-lifecycle-v",
      "archive": "gateprobes-operator-lifecycle-{version}-linux-amd64.tar.gz",
      "manifests": [
        "plugin.json",
        "Cargo.toml"
      ]
    },
    "docker-runtime": {
      "tag_prefix": "docker-runtime-v",
      "archive": "gateprobes-docker-runtime-{version}-linux-amd64.tar.gz",
      "manifests": [
        "plugin.json"
      ]
    },
    "runtime-importer": {
      "tag_prefix": "runtime-importer-v",
      "archive": "gateprobes-runtime-importer-{version}.tar.gz",
      "manifests": [
        "plugin.json"
      ]
    },
    "docker-readiness": {
      "tag_prefix": "docker-readiness-v",
      "archive": "gateprobes-docker-readiness-{version}-linux-amd64.tar.gz",
      "manifests": [
        "plugin.json"
      ]
    }
